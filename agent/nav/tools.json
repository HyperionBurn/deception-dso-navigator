[
  {
    "type": "webhook",
    "name": "get_state",
    "description": "Read the current position, the last words said to the operator, and a nudge if the operator has been quiet too long. Call it after a silence prompt or after a reconnect.",
    "api_schema": {
      "url": "https://deception-dso-navigator.vercel.app/api/nav?tool=get_state",
      "method": "POST",
      "request_headers": {
        "x-navigator-route-key": {
          "secret_id": "REPLACE_WITH_SECRET_ID"
        }
      },
      "request_body_schema": {
        "type": "object",
        "required": [
          "session_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "The session id. Filled in automatically.",
            "dynamic_variable": "session_id"
          }
        }
      }
    },
    "response_timeout_secs": 8,
    "execution_mode": "immediate",
    "pre_tool_speech": "off"
  },
  {
    "type": "webhook",
    "name": "find_place",
    "description": "Match a place the visitor named, in English or Arabic, to a place on this floor. Returns one place, or a question to ask the visitor when several fit.",
    "api_schema": {
      "url": "https://deception-dso-navigator.vercel.app/api/nav?tool=find_place",
      "method": "POST",
      "request_headers": {
        "x-navigator-route-key": {
          "secret_id": "REPLACE_WITH_SECRET_ID"
        }
      },
      "request_body_schema": {
        "type": "object",
        "required": [
          "session_id",
          "query"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "The session id. Filled in automatically.",
            "dynamic_variable": "session_id"
          },
          "query": {
            "type": "string",
            "description": "What the visitor said, for example 'call booth' or 'kitchen'."
          }
        }
      }
    },
    "response_timeout_secs": 8,
    "execution_mode": "immediate",
    "pre_tool_speech": "off"
  },
  {
    "type": "webhook",
    "name": "plan_route",
    "description": "Start a route to a place. The first call asks the operator to confirm the start point. Say say_operator word for word.",
    "api_schema": {
      "url": "https://deception-dso-navigator.vercel.app/api/nav?tool=plan_route",
      "method": "POST",
      "request_headers": {
        "x-navigator-route-key": {
          "secret_id": "REPLACE_WITH_SECRET_ID"
        }
      },
      "request_body_schema": {
        "type": "object",
        "required": [
          "session_id",
          "destination_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "The session id. Filled in automatically.",
            "dynamic_variable": "session_id"
          },
          "destination_id": {
            "type": "string",
            "description": "One of: meeting_room, conference_room, call_booth_1, call_booth_2, call_booth_3, call_booth_4, team_tables, kitchen."
          },
          "lang": {
            "type": "string",
            "description": "The visitor's language: ar or en."
          }
        }
      }
    },
    "response_timeout_secs": 8,
    "execution_mode": "immediate",
    "pre_tool_speech": "off"
  },
  {
    "type": "webhook",
    "name": "confirm_step",
    "description": "Pass on what the operator said. Returns the next instruction. Always send the step_id from the last result.",
    "api_schema": {
      "url": "https://deception-dso-navigator.vercel.app/api/nav?tool=confirm_step",
      "method": "POST",
      "request_headers": {
        "x-navigator-route-key": {
          "secret_id": "REPLACE_WITH_SECRET_ID"
        }
      },
      "request_body_schema": {
        "type": "object",
        "required": [
          "session_id",
          "step_id",
          "result"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "The session id. Filled in automatically.",
            "dynamic_variable": "session_id"
          },
          "step_id": {
            "type": "integer",
            "description": "The step_id from the last tool result."
          },
          "result": {
            "type": "string",
            "description": "The operator's reply word: ok, ready, done, stopped, yes, no, free, busy, repeat, lost, blocked, wait, see, at."
          },
          "thing": {
            "type": "string",
            "description": "What the operator sees, only when result is see or at."
          },
          "side": {
            "type": "string",
            "description": "left or right, only when result is see."
          }
        }
      }
    },
    "response_timeout_secs": 8,
    "execution_mode": "immediate",
    "pre_tool_speech": "off"
  },
  {
    "type": "webhook",
    "name": "report_landmark",
    "description": "Fix the robot position from something the operator sees, for example the printer on the left.",
    "api_schema": {
      "url": "https://deception-dso-navigator.vercel.app/api/nav?tool=report_landmark",
      "method": "POST",
      "request_headers": {
        "x-navigator-route-key": {
          "secret_id": "REPLACE_WITH_SECRET_ID"
        }
      },
      "request_body_schema": {
        "type": "object",
        "required": [
          "session_id",
          "thing"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "The session id. Filled in automatically.",
            "dynamic_variable": "session_id"
          },
          "thing": {
            "type": "string",
            "description": "What the operator sees."
          },
          "side": {
            "type": "string",
            "description": "left or right"
          }
        }
      }
    },
    "response_timeout_secs": 8,
    "execution_mode": "immediate",
    "pre_tool_speech": "off"
  },
  {
    "type": "webhook",
    "name": "change_destination",
    "description": "Someone asked for a different place while the robot is moving. Returns the stop instruction first and what to tell both people.",
    "api_schema": {
      "url": "https://deception-dso-navigator.vercel.app/api/nav?tool=change_destination",
      "method": "POST",
      "request_headers": {
        "x-navigator-route-key": {
          "secret_id": "REPLACE_WITH_SECRET_ID"
        }
      },
      "request_body_schema": {
        "type": "object",
        "required": [
          "session_id",
          "destination_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "The session id. Filled in automatically.",
            "dynamic_variable": "session_id"
          },
          "destination_id": {
            "type": "string",
            "description": "The new place id."
          },
          "lang": {
            "type": "string",
            "description": "The language of the person who asked: ar or en."
          }
        }
      }
    },
    "response_timeout_secs": 8,
    "execution_mode": "immediate",
    "pre_tool_speech": "off"
  },
  {
    "type": "webhook",
    "name": "handover",
    "description": "Ask for a person. Use when you do not know, a tool fails, the position is unclear after two questions, or the visitor asks for a person.",
    "api_schema": {
      "url": "https://deception-dso-navigator.vercel.app/api/nav?tool=handover",
      "method": "POST",
      "request_headers": {
        "x-navigator-route-key": {
          "secret_id": "REPLACE_WITH_SECRET_ID"
        }
      },
      "request_body_schema": {
        "type": "object",
        "required": [
          "session_id",
          "reason"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "The session id. Filled in automatically.",
            "dynamic_variable": "session_id"
          },
          "reason": {
            "type": "string",
            "description": "A few words on why."
          }
        }
      }
    },
    "response_timeout_secs": 8,
    "execution_mode": "immediate",
    "pre_tool_speech": "off"
  }
]
